    private void AbrirActionPerformed(java.awt.event.ActionEvent evt) {                                      
        javax.swing.JFileChooser selector = new javax.swing.JFileChooser();

        int resultado = selector.showOpenDialog(this);

        if (resultado == javax.swing.JFileChooser.APPROVE_OPTION) {
            java.io.File archivo = selector.getSelectedFile();

            try {
                String contenido = new String(
                        java.nio.file.Files.readAllBytes(archivo.toPath())
                );

                jEditorPane1.setText(contenido);
            } catch (java.io.IOException e) {
                javax.swing.JOptionPane.showMessageDialog(
                        this,
                        "No se pudo abrir el archivo: " + e.getMessage()
                );
            }
        }
    }                                     

    private void GuardarActionPerformed(java.awt.event.ActionEvent evt) {                                        
        javax.swing.JFileChooser selector = new javax.swing.JFileChooser();

        int resultado = selector.showSaveDialog(this);

        if (resultado == javax.swing.JFileChooser.APPROVE_OPTION) {
            java.io.File archivo = selector.getSelectedFile();

            try (java.io.FileWriter escritor = new java.io.FileWriter(archivo)) {
                escritor.write(jEditorPane1.getText());
                javax.swing.JOptionPane.showMessageDialog(this, "Archivo guardado");
            } catch (java.io.IOException e) {
                javax.swing.JOptionPane.showMessageDialog(this, "Error al guardar: " + e.getMessage());
            }
        }
    }                                       

